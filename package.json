{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:tz": "TZ=Asia/Tokyo vitest run && TZ=America/New_York vitest run && TZ=UTC vitest run && TZ=America/Bogota vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nc24k \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e:ui": "playwright test tests/e2e/ui",
    "test:e2e:flow": "firebase emulators:exec --only firestore --project demo-nc24k \"playwright test tests/e2e/flow\"",
    "test:all": "npm run test:unit && npm run test:e2e:ui"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.1"
  }
}
